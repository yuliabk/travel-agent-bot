# Server-side FastAPI connection. Never expose TRAVEL_AGENT_WEB_TOKEN with NEXT_PUBLIC_.
TRAVEL_AGENT_API_URL=http://127.0.0.1:8000
TRAVEL_AGENT_WEB_TOKEN=replace_with_server_side_token

# Optional map geocoding used only by map export routes.
SERPAPI_API_KEY=

# Optional public analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXTAUTH_URL=http://localhost:3000
