# Web Form (Next.js) environment variables
# Copy this file to .env and fill in real values. Do NOT commit .env.

# Prisma / database connection string
DATABASE_URL=

# Base URL of the FastAPI backend that receives web form trip requests
# e.g. https://your-backend-domain.com
NEXT_PUBLIC_API_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional API keys used by server-side routes
ABACUSAI_API_KEY=
SERPAPI_API_KEY=
