# =============================================================================
# YB Travel Agent - environment configuration
# Copy this file to `.env` and fill in the values. Never commit your real .env.
# =============================================================================

# --- AI: Google Gemini (required) -------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- SerpApi: flights & hotels (optional; searches are skipped if empty) -----
SERPAPI_API_KEY=
# Default origin airport IATA code used for legacy flight search (e.g. TLV).
# Contract v1 does not use this value as a fallback for an unresolved destination.
DEFAULT_ORIGIN_IATA=TLV

# --- Contract v1 read-only live search --------------------------------------
# Disabled by default. Enable only after an approved live-search gate.
V1_LIVE_SEARCH_ENABLED=false

# --- Contract v1 human approval ----------------------------------------------
# Strong secret used only for POST /v1/proposals/approve.
# Leave empty to disable approval fail-closed. Never commit a real token.
OWNER_APPROVAL_TOKEN=

# --- Session store -----------------------------------------------------------
# If REDIS_URL is set, Redis is used; otherwise an in-memory store is used.
REDIS_URL=redis://localhost:6379
# Session time-to-live in seconds (default: 24h)
SESSION_TTL_SECONDS=86400
# Max conversation messages kept per user per channel
MAX_HISTORY_MESSAGES=20

# =============================================================================
# CHANNEL 1 - WhatsApp (Meta Cloud API)
# =============================================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token you set in the Meta webhook configuration (GET verification)
WHATSAPP_VERIFY_TOKEN=yb_travel_secret_token_2026
# App Secret from Meta -> used to verify X-Hub-Signature-256 on POST webhooks.
# Strongly recommended in production; if empty, signature checks are skipped.
WHATSAPP_APP_SECRET=
# Phone number of the human agent for handoff notifications & /resume command
AGENT_PHONE_NUMBER=

# =============================================================================
# CHANNEL 2 - Email (IMAP in / SMTP out)
# =============================================================================
# Set to true to enable the background IMAP poller
EMAIL_ENABLED=false
# Inbound (IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_inbox@example.com
IMAP_PASSWORD=your_app_password
IMAP_MAILBOX=INBOX
EMAIL_POLL_INTERVAL_SECONDS=60
# Outbound (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_inbox@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_inbox@example.com
SMTP_USE_TLS=true

# =============================================================================
# CHANNEL 3 - Web Form (POST /api/webform)
# =============================================================================
# If true, the web form also emails the reply (needs SMTP configured above)
WEBFORM_SEND_EMAIL_REPLY=false

# --- Rate limiting (slowapi syntax, e.g. "120/minute") -----------------------
RATE_LIMIT_WEBHOOK=120/minute
RATE_LIMIT_WEBFORM=10/minute

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=travel_agent.log
